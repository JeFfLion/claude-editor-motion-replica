{
  "name": "remotion-library",
  "version": "1.0.0",
  "description": "长期维护的 Remotion 动画库与多视频项目",
  "packageManager": "npm@11.12.1",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/media": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts --no-open",
    "build": "remotion bundle",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts",
    "still": "remotion still src/index.ts"
  },
  "allowScripts": {
    "esbuild": false
  }
}
